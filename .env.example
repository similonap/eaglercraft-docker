# Copy to .env and adjust values

# Host port that players connect to (Vanilla TCP and Eaglercraft WebSocket)
SERVER_PORT=25565

# JVM heap — use the same value for -Xms and -Xmx to avoid GC resize pauses
# Minimum recommended: 1G   Typical: 2G   Large servers: 4G+
MEMORY=2G

# ── Web client ────────────────────────────────────────────────────────────────

# Public hostname or IP address your players use to reach this machine.
# This is baked into the client HTML at container startup.
# - Local play:  localhost  (default)
# - LAN play:    your LAN IP, e.g. 192.168.1.100
# - Public play: your public IP or domain, e.g. mc.example.com
SERVER_HOST=localhost

# Port the web client is served on (browser HTTP)
CLIENT_PORT=8080

# Name displayed in the client's server list
SERVER_NAME=EaglercraftX
